---
import Product from "../layouts/Product.astro";
import InstallCommand from "../components/InstallCommand.astro";
import config from "../data/site.json";
import { guide, download } from "../data/links";
const app = `brew install --cask ${config.homebrewCask}`;
const converters = "brew install pdf2svg poppler ghostscript";
const full = `brew install --cask mactex-no-gui\n${converters}`;
const minimal = `brew install --cask basictex\n${converters}\nsudo /Library/TeX/texbin/tlmgr update --self\nsudo /Library/TeX/texbin/tlmgr install latexmk preview pdfcrop pgf mathtools`;
const aptSetup = `sudo apt update
sudo apt install curl
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://fermatter.github.io/apt/fermatter.gpg | sudo tee /etc/apt/keyrings/fermatter.gpg > /dev/null
curl -fsSL https://fermatter.github.io/apt/fermatter.sources | sudo tee /etc/apt/sources.list.d/fermatter.sources > /dev/null
sudo apt update`;
const ubuntuLatex =
  "sudo apt install latexmk texlive-latex-extra texlive-extra-utils texlive-pictures ghostscript pdf2svg poppler-utils lmodern cm-super-minimal";
---

<Product
  title="Download"
  description="Download FerMatter for macOS and install LaTeX or Typst."
>
  <header class="page-intro">
    <h1>Download</h1>
    <p class="lead">Apple Silicon Mac · macOS 14 or later</p>
    <p class="availability">Windows version in development.</p>
  </header>
  <div class="download-layout">
    <section class="download-section" id="mac">
      <h2>
        {config.releaseAvailable
          ? `FerMatter ${config.releaseName}`
          : "Development preview"}
      </h2>
      <div class="actions">
        {config.releaseAvailable && (
          <a class="button primary" href={download}>
            Download DMG ↓
          </a>
        )}
      </div>
      {config.releaseAvailable && (
        <>
          <h3>Install from DMG</h3>
          <ol>
            <li>Open the DMG and drag FerMatter.app into Applications.</li>
            <li>Eject the DMG.</li>
            <li>Open FerMatter from Applications.</li>
          </ol>
        </>
      )}
    </section>
    {config.releaseAvailable && (
      <section class="download-section" id="homebrew">
        <h2>Homebrew</h2>
        <InstallCommand label="FerMatter" command={app} />
      </section>
    )}
    {config.ubuntuAptAvailable && (
      <section class="download-section" id="ubuntu">
        <h2>For Ubuntu (experimental)</h2>
        <p>
          Ubuntu 24.04 · amd64. Limited testing; use file export for images.
          Native image clipboard and recoverable project deletion are
          unavailable.
        </p>
        <details>
          <summary>First-time APT setup</summary>
          <InstallCommand label="APT repository setup" command={aptSetup} />
        </details>
        <InstallCommand
          label="FerMatter for Ubuntu"
          command="sudo apt install fermatter"
        />
        <p>Install LaTeX or Typst separately:</p>
        <details>
          <summary>LaTeX tools for Ubuntu</summary>
          <InstallCommand label="Ubuntu LaTeX tools" command={ubuntuLatex} />
        </details>
        <p>
          For Typst, follow the{" "}
          <a href="https://github.com/typst/typst#installation">
            official installation instructions
          </a>
          .
        </p>
      </section>
    )}
    <section class="download-section" id="updates">
      <h2>Update</h2>
      <InstallCommand
        label="Homebrew update"
        command={`brew upgrade --cask ${config.homebrewCask}`}
      />
      {config.ubuntuAptAvailable && (
        <InstallCommand
          label="Ubuntu update"
          command={"sudo apt update\nsudo apt install --only-upgrade fermatter"}
        />
      )}
    </section>
    <section class="download-section" id="rendering-engines">
      <h2>Math rendering engine</h2>
      <p>
        FerMatter requires LaTeX or Typst to render equations and drawings. The
        commands below are for macOS.
      </p>
      {config.releaseAvailable && (
        <section id="install">
          <h3>LaTeX</h3>
          <h4>Full TeX Live</h4>
          <InstallCommand label="full TeX Live" command={full} />
          <h4>BasicTeX</h4>
          <InstallCommand label="BasicTeX" command={minimal} />
          <table>
            <thead>
              <tr>
                <th scope="col">TeX option</th>
                <th scope="col">Installer download</th>
                <th scope="col">Installed TeX files</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Full MacTeX</th>
                <td>6.4 GB</td>
                <td>10 GB</td>
              </tr>
              <tr>
                <th scope="row">BasicTeX + packages above</th>
                <td>134 MB + extra packages</td>
                <td>0.5–1.3 GB</td>
              </tr>
            </tbody>
          </table>
        </section>
      )}
      {config.releaseAvailable && (
        <section id="typst">
          <h3>Typst</h3>
          <InstallCommand label="Typst" command="brew install typst" />
        </section>
      )}
    </section>
    <section class="download-section" id="requirements">
      <a href={guide("requirements")}>Requirements →</a>
    </section>
  </div>
</Product>
