---
import { getEntry, render } from "astro:content";
import Product from "../layouts/Product.astro";
import DownloadPlatform from "../components/DownloadPlatform.astro";
import config from "../data/site.json";
import { download, href, windowsDownload } from "../data/links";
const macos = (await getEntry("download", "macos"))!;
const windows = (await getEntry("download", "windows"))!;
const ubuntu = (await getEntry("download", "ubuntu"))!;
const { title, description, requirements } = macos.data;
const { Content: MacOS } = await render(macos);
const { Content: Windows } = await render(windows);
const { Content: WindowsInstaller } = await render(
  (await getEntry("download", "windows-installer"))!,
);
const { Content: Ubuntu } = await render(ubuntu);
---

<Product markdown title={title} description={description}>
  <header class="page-intro not-content">
    <h1>{title}</h1>
  </header>
  <nav
    class="download-platform-tabs not-content"
    aria-label="Operating system"
    data-download-tabs
  >
    <a id="download-tab-mac" href="#mac">
      macOS
    </a>
    <a id="download-tab-windows" href="#windows">
      Windows
    </a>
    {config.ubuntuAptAvailable && (
      <a id="download-tab-ubuntu" href="#ubuntu">
        Linux
      </a>
    )}
  </nav>
  <DownloadPlatform
    id="mac"
    version={config.releaseAvailable ? config.releaseName : config.version}
    requirements={requirements!}
    action={
      config.releaseAvailable
        ? { href: download, label: "Download DMG ↓" }
        : undefined
    }
  >
    {config.releaseAvailable && (
      <>
        <p class="download-notes">
          <a href={href("download/macos-notes/")}>
            Download verification and opening notes →
          </a>
        </p>
        <MacOS />
      </>
    )}
  </DownloadPlatform>
  <DownloadPlatform
    id="windows"
    version={
      config.windowsReleaseAvailable ? config.windowsReleaseName : config.version
    }
    requirements={windows.data.platform!}
    action={
      config.windowsReleaseAvailable
        ? { href: windowsDownload, label: "Download EXE ↓" }
        : undefined
    }
  >
    <h3 id="windows-install">Install</h3>
    {config.windowsReleaseAvailable ? (
      <WindowsInstaller />
    ) : (
      <p>{windows.data.availability}</p>
    )}
    <Windows />
  </DownloadPlatform>
  {config.ubuntuAptAvailable && (
    <DownloadPlatform
      id="ubuntu"
      version={config.ubuntuReleaseName}
      requirements={ubuntu.data.platform!}
      action={{ href: "#ubuntu-install", label: "Install with APT" }}
    >
      <Ubuntu />
    </DownloadPlatform>
  )}
</Product>

<style>
  .download-notes {
    margin-bottom: 2rem;
  }
</style>

<script>
  import "../scripts/download-tabs.js";
</script>
