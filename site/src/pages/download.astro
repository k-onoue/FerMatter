---
import { getEntry, render } from "astro:content";
import Product from "../layouts/Product.astro";
import config from "../data/site.json";
import { download, windowsDownload, releases } from "../data/links";
const macos = (await getEntry("download", "macos"))!;
const windows = (await getEntry("download", "windows"))!;
const { title, description, requirements } = macos.data;
const { Content: MacOS } = await render(macos);
const { Content: Windows } = await render(windows);
const { Content: WindowsInstaller } = await render(
  (await getEntry("download", "windows-installer"))!,
);
const { Content: Ubuntu } = await render(
  (await getEntry("download", "ubuntu"))!,
);
---

<Product markdown title={title} description={description}>
  <header class="page-intro not-content">
    <h1>{title}</h1>
  </header>
  <nav
    class="download-platform-tabs not-content"
    aria-label="Operating system"
    data-download-tabs
  >
    <a id="download-tab-mac" href="#mac">
      macOS
    </a>
    <a id="download-tab-windows" href="#windows">
      Windows
    </a>
    {config.ubuntuAptAvailable && (
      <a id="download-tab-ubuntu" href="#ubuntu">
        Linux
      </a>
    )}
  </nav>
  <section class="download-platform-panel" id="mac" data-download-panel>
    <div class="download-section not-content">
      <h2>
        {config.releaseAvailable
          ? `FerMatter ${config.releaseName}`
          : "Development preview"}
      </h2>
      {requirements && <p>{requirements}</p>}
      {config.releaseAvailable && (
        <div class="actions">
          <a class="button primary" href={download}>
            Download DMG ↓
          </a>
        </div>
      )}
    </div>
    {config.releaseAvailable && (
      <div class="download-markdown product-markdown sl-markdown-content">
        <MacOS />
      </div>
    )}
  </section>
  <section
    id="windows"
    class="download-platform-panel download-markdown product-markdown sl-markdown-content"
    data-download-panel
  >
    <h2>{windows.data.title}</h2>
    <p>{windows.data.platform}</p>
    {config.windowsReleaseAvailable ? (
      <>
        <p>{config.windowsReleaseName} · unsigned installer.</p>
        <div class="actions not-content">
          <a class="button primary" href={windowsDownload}>
            Download EXE ↓
          </a>
        </div>
        <p>
          <a href={`${releases}/tag/${config.windowsReleaseTag}`}>
            Release and SHA-256 checksum
          </a>
        </p>
        <WindowsInstaller />
      </>
    ) : (
      <p>{windows.data.availability}</p>
    )}
    <Windows />
  </section>
  {config.ubuntuAptAvailable && (
    <section
      id="ubuntu"
      class="download-platform-panel download-markdown product-markdown sl-markdown-content"
      data-download-panel
    >
      <Ubuntu />
    </section>
  )}
</Product>

<script>
  import "../scripts/download-tabs.js";
</script>
