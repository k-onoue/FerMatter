---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Product from "../../layouts/Product.astro";
import { href } from "../../data/links";
export async function getStaticPaths() {
  return (await getCollection("news")).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"news">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, status } = entry.data;
const dateLabel = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(date);
---

<Product markdown title={title} description={description}>
  <header class="page-intro not-content">
    <a href={href("news/")}>← News</a>
    <p class="news-meta">
      <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
      <span>{status === "upcoming" ? "Next release" : "Available"}</span>
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </header>
  <article class="product-markdown sl-markdown-content news-article">
    <Content />
  </article>
</Product>
