---
import Product from "../layouts/Product.astro";
import Demo from "../components/Demo.astro";
import demos from "../data/demos.json";
import { guide } from "../data/links";
---

<Product
  title="Features"
  description="See how FerMatter moves equations and diagrams from your paper to your presentation."
>
  <header class="page-intro">
    <h1>Features</h1>
    <nav class="feature-index" aria-label="Features on this page">
      {demos.map((demo) => (
        <a href={`#${demo.id}`}>
          {demo.id === "source"
            ? "Source & PDF"
            : demo.id[0].toUpperCase() + demo.id.slice(1)}
        </a>
      ))}
    </nav>
  </header>
  <div class="demo-grid">
    {demos.map((demo, i) => (
      <Demo id={demo.id} eager={i < 2} />
    ))}
  </div>
  <section class="details-grid">
    <div>
      <h2>
        <a href={guide("export", "re-edit-svg")}>Editable SVG</a>
      </h2>
      <p>Reopen supported SVG exports to edit their source.</p>
    </div>
    <div>
      <h2>
        <a href={guide("appearance")}>Appearance</a>
      </h2>
      <p>Choose a theme, adjust background opacity, or pin the window.</p>
    </div>
    <div>
      <h2>
        <a href={guide("automation")}>MCP</a>
      </h2>
      <p>Search projects, render equations, and export from a local agent.</p>
    </div>
  </section>
</Product>
