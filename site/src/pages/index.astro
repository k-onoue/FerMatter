---
import Product from "../layouts/Product.astro";
import { href, guide } from "../data/links";
import config from "../data/site.json";
import { Image } from "astro:assets";
import dragFromPdf from "../../public/assets/demos/drag-from-pdf.webp";
const title = "The Ultimate Drag-and-Drop Equations Workspace.";
const description =
  "Easily paste equations from your LaTeX paper source into PowerPoint (.pptx) as SVG.";
---

<Product title={title} description={description}>
  <section class="home-intro">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="actions">
      <a
        class="button primary"
        href={config.releaseAvailable ? href("download/#mac") : guide()}
      >
        {config.releaseAvailable ? "Download for macOS ↓" : "Get started"}
      </a>
    </div>
    <p class="availability">
      macOS · Apple Silicon
      <br />
      Windows version in development.
    </p>
  </section>
  <figure class="home-drag">
    <a href={guide("paper-to-slides", "pdf")}>
      <Image
        src={dragFromPdf}
        alt="Source code on the left and the paper PDF on the right, with an equation being dragged from the highlighted PDF formula."
        widths={[640, 1280, 1800]}
        sizes="(max-width: 800px) 100vw, 768px"
        loading="lazy"
        quality={90}
      />
    </a>
    <figcaption>
      <h2>
        <a href={guide("paper-to-slides", "pdf")}>
          Drag straight from the paper PDF.
        </a>
      </h2>
      <p>Also from Library cards, Source previews, and Instant.</p>
    </figcaption>
  </figure>
</Product>
