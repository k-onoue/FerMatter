---
import { getNews, newsDate } from "../data/news";
import Product from "../layouts/Product.astro";
import { href, guide } from "../data/links";
import config from "../data/site.json";
import { Image } from "astro:assets";
import dragFromPdf from "../../public/assets/demos/drag-from-pdf.webp";
const news = (await getNews()).slice(0, 5);
const title = "The Ultimate Drag-and-Drop Equations Workspace.";
const description =
  "Easily paste equations from your LaTeX paper source into PowerPoint (.pptx) as SVG.";
---

<Product title={title} description={description}>
  <section class="home-intro">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="actions">
      <a
        class="button primary"
        href={
          config.releaseAvailable || config.windowsReleaseAvailable
            ? href("download/")
            : guide()
        }
      >
        {config.releaseAvailable || config.windowsReleaseAvailable
          ? "Download ↓"
          : "Get started"}
      </a>
    </div>
    <p class="availability">
      macOS · Apple Silicon
      <br />
      {config.windowsReleaseAvailable
        ? "Windows 11 · x64 preview"
        : "Windows version in development."}
    </p>
  </section>
  <figure class="home-drag">
    <a href={guide("paper-to-slides", "pdf")}>
      <Image
        src={dragFromPdf}
        alt="Source code on the left and the paper PDF on the right, with an equation being dragged from the highlighted PDF formula."
        widths={[640, 1280, 1800]}
        sizes="(max-width: 800px) 100vw, 768px"
        loading="lazy"
        quality={90}
      />
    </a>
    <figcaption>
      <h2>
        <a href={guide("paper-to-slides", "pdf")}>
          Drag straight from the paper PDF.
        </a>
      </h2>
      <p>Also from Library cards, Source previews, and Instant.</p>
      <p>
        <a href={href("features/")}>See other features →</a>
      </p>
    </figcaption>
  </figure>
  {news.length > 0 && (
    <section class="home-news" aria-labelledby="home-news-title">
      <div class="home-news-heading">
        <h2 id="home-news-title">News</h2>
        <a href={href("news/")}>All news →</a>
      </div>
      <ul role="list">
        {news.map(({ id, data }) => (
          <li>
            <time datetime={newsDate(data.date)}>{newsDate(data.date)}</time>
            <a href={href(`news/${id}/`)}>{data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Product>
