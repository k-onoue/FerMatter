---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import GuideNavigation from "../components/GuideNavigation.astro";
interface Props {
  title: string;
  description: string;
  markdown?: boolean;
  guideSection?: "resolved";
}
const { title, description, markdown = false, guideSection } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: "splash",
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
  }}
  hasSidebar={false}
>
  <div id="_top" class:list={["product-page", { "not-content": !markdown }]}>
    {guideSection && <GuideNavigation active={guideSection} />}
    <slot />
  </div>
</StarlightPage>
