---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page">
  <header class="header">
    <slot name="header" />
  </header>
  {hasSidebar && (
    <nav
      class="sidebar print:hidden"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <MobileMenuToggle />
      <fm-sidebar-pane
        popover="auto"
        id="starlight__sidebar"
        class="sidebar-pane"
      >
        <div class="sidebar-content sl-flex">
          <slot name="sidebar" />
        </div>
      </fm-sidebar-pane>
    </nav>
  )}
  <div class="main-frame">
    <slot />
  </div>
</div>

<script>
  class FerMatterSidebar extends HTMLElement {
    // Keep this breakpoint in sync with styles/layout.css.
    private desktop = matchMedia("(min-width: 90rem)");

    private syncLayout = () => {
      this.popover = this.desktop.matches ? null : "auto";
      this.syncFocus();
    };

    private syncFocus = () => {
      const open = !this.desktop.matches && this.matches(":popover-open");
      document
        .querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link")
        .forEach((el) => {
          el.inert = open;
        });
    };

    connectedCallback() {
      this.syncLayout();
      this.desktop.addEventListener("change", this.syncLayout);
      this.addEventListener("toggle", this.syncFocus);
    }

    disconnectedCallback() {
      this.desktop.removeEventListener("change", this.syncLayout);
      this.removeEventListener("toggle", this.syncFocus);
    }
  }
  customElements.define("fm-sidebar-pane", FerMatterSidebar);
</script>
