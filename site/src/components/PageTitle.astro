---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
import MobileTableOfContents from "@astrojs/starlight/components/MobileTableOfContents.astro";
import { href } from "../data/links";
const product =
  [href(), href("features/"), href("download/"), href("declaration/")].includes(
    Astro.url.pathname,
  ) ||
  Astro.url.pathname.startsWith(href("news/")) ||
  Astro.url.pathname.startsWith(href("resolved-issues/")) ||
  Astro.url.pathname.startsWith(href("download/"));
---

{!product && (
  <>
    <PageTitle />
    {Astro.locals.starlightRoute.toc && (
      <div class="fm-mobile-toc print:hidden">
        <MobileTableOfContents />
      </div>
    )}
  </>
)}
