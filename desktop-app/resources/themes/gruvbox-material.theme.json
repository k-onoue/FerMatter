    "windowBackground": "#FBF1C7",
    "surfaceBackground": "#FBF1C7",
    "text": "#654735",
    "command": "#C14A4A",
    "delimiter": "#654735",
    "number": "#945E80",
    "comment": "#928374"
  },
  "dark": {
    "accent": "#A9B665",
    "windowBackground": "#292828",
