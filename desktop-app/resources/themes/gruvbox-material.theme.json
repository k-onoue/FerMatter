    "text": "#D4BE98",
    "command": "#EA6962",
    "delimiter": "#D4BE98",
    "number": "#D3869B",
    "comment": "#928374"
  },
  "extensions": {
    "org.mathlidelux.theme-source": {
      "variants": {
        "light": "Gruvbox Material Light",
        "dark": "Gruvbox Material Dark"
