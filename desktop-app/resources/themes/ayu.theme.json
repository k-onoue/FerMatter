      "variants": {
        "light": "Ayu Light",
        "dark": "Ayu Dark"
      },
      "sources": [
        {
          "repository": "https://github.com/ayu-theme/ayu-colors",
          "revision": "38fc9f521ed30c130a7acd8261de2239e8b1989e",
