    "delimiter": "#E59645",
    "number": "#A37ACC",
    "comment": "#ADAEB1"
  },
  "dark": {
    "accent": "#E6B450",
    "windowBackground": "#10141C",
    "surfaceBackground": "#0D1017",
    "text": "#BFBDB6",
    "command": "#FF8F40",
    "delimiter": "#F29668",
    "number": "#D2A6FF",
