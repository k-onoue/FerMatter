{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerMatter",
  "version": "0.11.0",
  "identifier": "io.github.fermatter.fermatter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FerMatter",
        "width": 1360,
        "height": 880,
        "minWidth": 850,
        "minHeight": 550,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Equations and figures for your slides",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "bundleVersion": "15",
      "hardenedRuntime": true
    },
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../resources/themes/": "themes/",
      "../public/vendor/JAVASCRIPT-LICENSES.txt": "licenses/JAVASCRIPT-LICENSES.txt",
      "../public/vendor/RUST-LICENSES.txt": "licenses/RUST-LICENSES.txt"
    },
    "fileAssociations": [
      {
        "ext": ["svg"],
        "name": "SVG image",
        "description": "Editable FerMatter SVG",
        "mimeType": "image/svg+xml",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "mainBinaryName": "FerMatter",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEREZFQUQ2MkIwMzhBQzgKUldUSWlnTXIxdXJmN1l5U0RVaHI5U0M2WUhBdWhIY0tCU0pjQVJEMW16bmNXaUhqYWFkUXkxOUoK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
